{
  "config_version": "baseline-v2",
  "seed": 42,
  "device": "cpu",
  "labels": [
    "left",
    "right",
    "up",
    "down",
    "go",
    "stop",
    "unknown",
    "silence"
  ],
  "features": {
    "version": "mfcc-v1",
    "sample_rate": 16000,
    "channels": 1,
    "dtype": "float32",
    "frame_ms": 25,
    "hop_ms": 10,
    "n_mfcc": 40,
    "n_mels": 40,
    "n_fft": 512,
    "window_samples": 16000,
    "window": "symmetric-hamming",
    "mel_scale": "htk-unscaled-triangles-20-7600Hz",
    "spectrum": "abs-rfft-squared/512",
    "log": "natural-floor-1e-10",
    "dct": "type-2-ortho",
    "padding": "right-zero-to-1s-truncate-longer-no-center",
    "resampling": "scipy-resample-poly-kaiser-5-constant",
    "normalization": "train-only-per-coefficient-population-std-floor-1e-6"
  },
  "network": {
    "type": "lstm",
    "hidden_size": 64,
    "num_layers": 1
  },
  "training": {
    "batch_size": 16,
    "optimizer": "adam",
    "loss": "cross_entropy"
  },
  "spotting": {
    "window_s": 1.0,
    "stride_s": 0.25,
    "threshold": null,
    "consecutive_windows": null,
    "cooldown_s": 1.2,
    "status": "Uncalibrated. Tune on validation only; freeze before test."
  }
}
